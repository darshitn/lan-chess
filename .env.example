# Environment: development | production | test
APP_ENV=development
APP_NAME=Multi-Agent AI Workspace
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Database - use backend/data/app.db (absolute default if unset)
DATABASE_URL=sqlite:///./backend/data/app.db
# For tests an in-memory or temp file DB is used automatically.

# CORS - JSON array (also supports comma string via fallback)
# Use JSON array format for reliability: ["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security (do not commit real values)
# Provider credentials are backend-only and never exposed to frontend.
# Store real keys in a local .env (gitignored), not in .env.example.
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_URL=http://127.0.0.1:11434  # alias for OLLAMA_HOST

# Frontend (Vite prefix required)
# VITE_API_BASE_URL can be omitted to use vite proxy (/api -> backend)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_S=30

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_NAME=Multi-Agent AI Workspace

# Optional workspace override
# WORKSPACE_ROOT=D:\Projects\Multi-Agent-Interface\workspace
