{
  "name": "lan-chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "npm run build:server && concurrently -k -n types,server -c yellow,blue \"tsc -p tsconfig.server.json --watch\" \"node --watch dist/server/server/index.js\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run server/network.test.ts",
    "start": "node dist/server/server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "chess.js": "latest",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io-client": "latest",
    "socket.io": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "vitest": "latest"
  }
}
